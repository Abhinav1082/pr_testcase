{
    "name": "com.demo.fioriapp",
    "version": "1.0.0",
    "description": "Demo Fiori App for Automated Testing",
    "private": true,
    "scripts": {
        "start": "ui5 serve --open index.html",
        "build": "ui5 build --clean-dest",
        "test": "karma start",
        "test:unit": "karma start --single-run --browsers ChromeHeadless",
        "test:integration": "karma start karma-integration.conf.js --single-run --browsers ChromeHeadless",
        "lint": "eslint webapp"
    },
    "devDependencies": {
        "@ui5/cli": "^3.0.0",
        "@openui5/sap.m": "^1.120.0",
        "@openui5/sap.ui.core": "^1.120.0",
        "@openui5/sap.f": "^1.120.0",
        "@openui5/themelib_sap_horizon": "^1.120.0",
        "karma": "^6.4.0",
        "karma-chrome-launcher": "^3.2.0",
        "karma-coverage": "^2.2.0",
        "karma-qunit": "^4.2.0",
        "karma-ui5": "^3.0.0",
        "qunit": "^2.20.0"
    }
}
